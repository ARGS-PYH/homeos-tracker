# Copy this to .env and fill in your Firebase client config
# Used by Vite as `import.meta.env.VITE_*`

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend URL for local Vite development.
# Leave empty in production when the frontend and API are served by the same app.
VITE_API_URL=http://localhost:3000

# Backend service account for local API/server testing.
# Option 1: path to the downloaded JSON file
FIREBASE_SERVICE_ACCOUNT_FILE=

# Option 2: full one-line JSON string
FIREBASE_SERVICE_ACCOUNT=
